Include ~/.ssh/config.local
Include ~/.ssh/config.d/*.conf

Host fd
  HostName floppy-disk
  Port 2222

Host town
  HostName tilde.town
  RequestTTY yes
  RemoteCommand tmux new-session -A -s meow

Host *
  IgnoreUnknown UseKeychain
  UseKeychain yes
  AddKeysToAgent yes
  StrictHostKeyChecking accept-new
